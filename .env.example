VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_PHONE_AUTH_ENABLED=false
# Server-only credentials. Never prefix these with VITE_.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Private Backblaze B2 bucket; all B2 settings stay on the server.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
PORT=3001

# Local OmniView admin integration; generate a long random token.
OMNIVIEW_ADMIN_TOKEN=
OMNIVIEW_SERVER_URL=http://localhost:3001

# Supabase Send SMS hook and the sender phone's gateway account (server only).
SUPABASE_SMS_HOOK_SECRET=
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=
SMS_GATE_DEVICE_ID=
